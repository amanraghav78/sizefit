{
  "expo": {
    "name": "SizeFit",
    "slug": "sizefit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "scheme": "sizefit",
    "backgroundColor": "#FBF8F3",
    "android": {
      "package": "com.sizefit.app",
      "minSdkVersion": 26,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9B2C1E"
      }
    },
    "ios": {
      "bundleIdentifier": "com.sizefit.app",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#9B2C1E",
          "dark": {
            "backgroundColor": "#6E1C12"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SizeFit needs access to your photos so it can resize the one you pick. Files never leave your device."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "SizeFit saves the resized file to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
